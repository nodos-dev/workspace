    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'nosman'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=nosman",
                    "--package=nosman"
                ],
                "filter": {
                    "name": "nosman",
                    "kind": "bin"
                }
            },
            "args": ["--workspace", "C:/dev/nodos-ws-exp", "create", "plugin", "nos.slmslm", "-o", "C:/dev/nodos-ws-exp/Module"],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'nosman'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=nosman",
                    "--package=nosman"
                ],
                "filter": {
                    "name": "nosman",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}